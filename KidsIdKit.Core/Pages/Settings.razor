@page "/Settings"
@using KidsIdKit.Core.Services

@inject IBiometricService BiometricService
@inject IPinService PinService
@inject ICloudBackupService CloudBackupService
@inject IPageState PageState

<ion-header>
    <ion-toolbar color="primary">
        <ion-buttons slot="start">
            <ion-button style="--box-shadow: none">
                <ion-menu-button></ion-menu-button>
            </ion-button>
        </ion-buttons>
        <ion-title>Settings</ion-title>
    </ion-toolbar>
</ion-header>
<ion-content class="ion-padding">
@{
    var enableBiometricsState = PageState.GetStateItem<bool>(EnableBiometricsState);
    var isBiometricsAvailable = PageState.GetStateItem<bool>(IsBiometricAvailableState);
    var enableCloudBackupsState = PageState.GetStateItem<bool>(EnableCloudBackupsState);
    var isCloudBackupSupported = PageState.GetStateItem<bool>(IsCloudBackupSupportedState);

    var stateInformation = PageState.GetStateItem<string>(AlertStateInformationState);
    var alertTitle = PageState.GetStateItem<string>(AlertTitleState);
    var alertMessage = PageState.GetStateItem<string>(AlertMessage);
}
    <ion-list lines="full">
        <ion-item>
            <ion-label>Enable Biometrics</ion-label>
            <EditBool @bind-Value="enableBiometricsState.Value"
                      OnValueChanged="@(value => OnEnableBiometricsChanged(value))"
                      Disabled="@(!isBiometricsAvailable.Value)" />
        </ion-item>
        <ion-item>
            <ion-label>Allow Cloud Backups</ion-label>
            <EditBool @bind-Value="enableCloudBackupsState.Value"
                      OnValueChanged="@(value => OnEnableCloudBackupsChanged(value))" 
                      Disabled="@(!isCloudBackupSupported.Value)" />
        </ion-item>
    </ion-list>
    
    <McmAlert Header="@alertTitle.Value"
              Message="@alertMessage.Value"
              ConfirmPrompt="OK"
              CancelPrompt="Cancel"
              Show="PageState.GetStateItem<bool>(AlertShowState).Value"
              StateInformation="@stateInformation.Value"
              AlertClosed="@(result => OnAlertClosed(result))" />

</ion-content>
