@page "/About"

@using KidsIdKit.Core.Services

@inject IAppInformation AppInformation

<ion-header>
    <ion-toolbar color="primary">
        <ion-buttons slot="start">
            <ion-button style="--box-shadow: none">
                <ion-menu-button></ion-menu-button>
            </ion-button>
        </ion-buttons>
        <ion-title>About</ion-title>
    </ion-toolbar>
</ion-header>
<ion-content class="ion-padding">
    <section>
        <i>
            The Kids Id Kit app allows parents to maintain a digital record of their kids' information; it is a simple app that allows parents to add and maintain information
            about their kids. It also provides helpful links to resources that parents can use to help keep their kids safe.
        </i>
    </section>
    <br />
    <ul id="inline-links-in-a-list">
        <li>
            Click on the <a href="/">Kids</a> tab to enter, edit, and/or simply view information about your kids.
        </li>

        <li>
            Click on the <a href="/Information">Information</a> tab to see helpful links to resources that parents can use to help keep your kids safe.
        </li>

        <li>
            Click on the <a href="/Export">Export Data</a> tab to export your kids' information. It is intended to be used to load into
            another instance of Kids Id Kit using the same PIN to unlock it. The export can be used to back up the data or to synchronize
            the data with another device running the Kids ID Kit application.
        </li>

        <li>
            Click on the <a href="/Settings">Settings</a> tab to view/change application settings.
        </li>
    </ul>

    <hr/>

    <div class="ion-padding" slot="fixed" style="bottom:5px;left:5px;right:5px">
        <div style="font-size: 1rem; font-weight: 600;">Version:</div>
        <ion-label>@AppInformation.VersionName</ion-label>
    </div>
</ion-content>
