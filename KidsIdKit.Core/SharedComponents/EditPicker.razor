@inherits InputBase<string>
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* Select-style field that opens an iOS-style wheel picker (ion-picker) in a
   small modal. Nothing is committed while scrolling: when Done is tapped the
   wheel's selected value is read directly via a small JS module (waiting for
   Ionic's "ionChange" event instead would race a quick tap on Done, since it
   only fires after the wheel settles) and applied to the bound value, so
   validation cannot fire mid-scroll and a backdrop dismiss cancels. Each
   wheel row pairs the platform's
   brand icon tile with its name (ion-picker-column-option slots its
   children), and the selected platform's tile also stays visible on the
   field. When AllowOther is set, the wheel ends with an "Other" row that
   reveals a text box under the field so a platform missing from Options can
   be typed in; a stored value that is not in Options selects "Other"
   automatically with the text box pre-filled. *@
@* The field and the conditional "Other" text box live in their own wrapper:
   Ionic relocates the inline ion-modal element within the DOM when it is
   presented, so any conditional markup rendered as a direct sibling of the
   modal would be inserted beside the modal's new location (the bottom of the
   page) instead of under the field. *@
<div class="picker-host">
    <button type="button" class="picker-field" id="@_triggerId"
            aria-haspopup="dialog" style="@Style">
        @if (CurrentIcon is ComboOptionIcon currentIcon)
        {
            <PlatformIcon Icon="currentIcon" />
        }
        <span class="picker-field-label @(string.IsNullOrEmpty(CurrentValue) && !IsOther ? "is-placeholder" : null)">
            @(IsOther ? OtherLabel : string.IsNullOrEmpty(CurrentValue) ? Placeholder : CurrentValue)
        </span>
        <ion-icon class="picker-field-arrow" name="chevron-expand-outline" aria-hidden="true"></ion-icon>
    </button>

    @if (IsOther)
    {
        <div class="picker-other-input">
            <EditText @bind-Value="@CurrentValue" />
        </div>
    }
</div>

<ion-modal class="picker-modal" trigger="@_triggerId" keep-contents-mounted="true" @ref="_modalRef">
    <ion-toolbar>
        <ion-buttons slot="end">
            <ion-button strong="true" @onclick="DoneAsync">Done</ion-button>
        </ion-buttons>
    </ion-toolbar>
    <ion-picker>
        <ion-picker-column value="@WheelValue" @ref="_columnRef">
            @foreach (var option in WheelOptions)
            {
                <ion-picker-column-option value="@option" @key="option">
                    <span class="picker-option">
                        <span class="picker-option-icon" aria-hidden="true">
                            <PlatformIcon Icon="GetIcon(option)" Size="20" />
                        </span>
                        <span class="picker-option-label">@option</span>
                    </span>
                </ion-picker-column-option>
            }
        </ion-picker-column>
    </ion-picker>
</ion-modal>

@code {
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; } = "Select";
    [Parameter] public string? Style { get; set; }

    // When true, the wheel ends with an "Other" row that reveals a text box
    // for entering a platform that is not in Options.
    [Parameter] public bool AllowOther { get; set; }

    private const string OtherLabel = "Other";

    // Optional: maps an option value to a brand-styled icon (logo glyph plus
    // tile color). Returns null when an option has no associated graphic.
    [Parameter] public Func<string, ComboOptionIcon?>? IconResolver { get; set; }

    // Ties the modal to the field button so Ionic manages open/close.
    private readonly string _triggerId = $"edit-picker-{Guid.NewGuid():N}";

    // Icon for the currently selected value, shown as a leading tile so the
    // selected platform's graphic stays visible on the field.
    private ComboOptionIcon? CurrentIcon =>
        string.IsNullOrEmpty(CurrentValue) ? null : IconResolver?.Invoke(CurrentValue);

    private ComboOptionIcon? GetIcon(string option) => IconResolver?.Invoke(option);

    // True while the value is entered via the text box: either the user
    // picked "Other" on the wheel, or the stored value is not in Options
    // (e.g., saved before an option list changed, or entered as free text
    // historically).
    private bool _otherChosen;

    private bool IsOther =>
        AllowOther && (_otherChosen ||
            (!string.IsNullOrEmpty(CurrentValue) && !Options.Contains(CurrentValue, StringComparer.Ordinal)));

    // The wheel highlights "Other" while in custom mode; otherwise it tracks
    // the bound value.
    private string WheelValue => IsOther ? OtherLabel : CurrentValue ?? string.Empty;

    private IEnumerable<string> WheelOptions =>
        AllowOther
            ? Options.Append(OtherLabel)
            : !string.IsNullOrEmpty(CurrentValue) && !Options.Contains(CurrentValue, StringComparer.Ordinal)
                ? Options.Append(CurrentValue)
                : Options;

    private ElementReference _columnRef;
    private ElementReference _modalRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    private async Task DoneAsync()
    {
        try
        {
            if (_module is not null)
            {
                var picked = await _module.InvokeAsync<string?>("getValue", _columnRef);
                if (!string.IsNullOrEmpty(picked))
                {
                    if (AllowOther && string.Equals(picked, OtherLabel, StringComparison.Ordinal))
                    {
                        _otherChosen = true;
                        // Keep an existing custom value; only clear a listed
                        // one so the text box starts blank for a fresh
                        // "Other" entry.
                        if (Options.Contains(CurrentValue, StringComparer.Ordinal))
                        {
                            CurrentValue = string.Empty;
                        }
                    }
                    else
                    {
                        _otherChosen = false;
                        CurrentValue = picked;
                    }
                }

                await _module.InvokeVoidAsync("dismiss", _modalRef);
            }
        }
        catch
        {
            // If JS interop is unavailable, the backdrop still dismisses.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/KidsIdKit.Core/js/ion-picker.js");
                _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _columnRef, _modalRef);
            }
            catch
            {
                // If JS interop is unavailable (e.g., prerendering), silently skip.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_handle is not null)
        {
            try { await _handle.InvokeVoidAsync("dispose"); } catch { }
            try { await _handle.DisposeAsync(); } catch { }
            _handle = null;
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
    }
}
