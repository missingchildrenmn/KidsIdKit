@inherits InputBase<string>
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* Select-style field that opens an iOS-style wheel picker (ion-picker) in a small modal. The wheel commits the value
   live: ion-picker-column raises Ionic's "ionChange" custom event (not a standard DOM event Blazor can bind), so a small
   JS module forwards each picked value back to .NET; the [Done] button just closes the modal. Each wheel row pairs the
   platform's brand icon tile with its name (ion-picker-column-option slots its children), and the selected platform's tile
   also stays visible on the field. The stored value is appended as an extra option when it is not in
   Options so previously saved free-text values still display and can be re-selected. *@
<button type="button" class="picker-field" id="@_triggerId"
        aria-haspopup="dialog" style="@Style">
    @if (CurrentIcon is ComboOptionIcon currentIcon)
    {
        <PlatformIcon Icon="currentIcon" />
    }
    <span class="picker-field-label @(string.IsNullOrEmpty(CurrentValue) ? "is-placeholder" : null)">
        @(string.IsNullOrEmpty(CurrentValue) ? Placeholder : CurrentValue)
    </span>

    <ion-icon class="picker-field-arrow" name="chevron-expand-outline" aria-hidden="true"></ion-icon>
</button>

<ion-modal class="picker-modal" trigger="@_triggerId" keep-contents-mounted="true" @ref="_modalRef">
    <ion-toolbar>
        <ion-buttons slot="end">
            <ion-button strong="true" @onclick="DoneAsync">Done</ion-button>
        </ion-buttons>
    </ion-toolbar>

    <ion-picker>
        <ion-picker-column value="@CurrentValue" @ref="_columnRef">
            @foreach (var option in EffectiveOptions)
            {
                <ion-picker-column-option value="@option" @key="option">
                    <span class="picker-option">
                        <span class="picker-option-icon" aria-hidden="true">
                            <PlatformIcon Icon="GetIcon(option)" Size="20" />
                        </span>
                        <span class="picker-option-label">@option</span>
                    </span>
                </ion-picker-column-option>
            }
        </ion-picker-column>
    </ion-picker>
</ion-modal>

@code {
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; } = "Select";
    [Parameter] public string? Style { get; set; }

    // Optional: maps an option value to a brand-styled icon (logo glyph plus
    // tile color). Returns null when an option has no associated graphic.
    [Parameter] public Func<string, ComboOptionIcon?>? IconResolver { get; set; }

    // Ties the modal to the field button so Ionic manages open/close.
    private readonly string _triggerId = $"edit-picker-{Guid.NewGuid():N}";

    // Icon for the currently selected value, shown as a leading tile so the
    // selected platform's graphic stays visible on the field.
    private ComboOptionIcon? CurrentIcon => string.IsNullOrEmpty(CurrentValue) ? null : IconResolver?.Invoke(CurrentValue);

    private ComboOptionIcon? GetIcon(string option) => IconResolver?.Invoke(option);

    // Surfaces the current value as an option when it is not already listed
    // (e.g., values saved before an option list changed, or entered as free
    // text historically).
    private IEnumerable<string> EffectiveOptions =>
        !string.IsNullOrEmpty(CurrentValue) && !Options.Contains(CurrentValue, StringComparer.Ordinal)
            ? Options.Append(CurrentValue)
            : Options;

    private ElementReference _columnRef;
    private ElementReference _modalRef;
    private DotNetObjectReference<EditPicker>? _objRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    [JSInvokable]
    public void UpdateValue(string? newValue)
    {
        CurrentValue = newValue ?? string.Empty;
    }

    private async Task DoneAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dismiss", _modalRef);
            }
        }
        catch
        {
            // If JS interop is unavailable, the backdrop still dismisses.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/KidsIdKit.Core/js/ion-picker.js");
                _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _columnRef, _objRef);
            }
            catch
            {
                // If JS interop is unavailable (e.g., prerendering), silently skip.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_handle is not null)
        {
            try { await _handle.InvokeVoidAsync("dispose"); } catch { }
            try { await _handle.DisposeAsync(); } catch { }
            _handle = null;
        }

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
        _objRef?.Dispose();
    }
}
