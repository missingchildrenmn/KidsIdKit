@inject IPhotoService PhotoService
@inject IPageState PageState

@using Microsoft.AspNetCore.Components.Forms
@using KidsIdKit.Core.Data
@using KidsIdKit.Core.Services

<ion-list>
    <ion-list-header>
        <ion-label>@Label</ion-label>
    </ion-list-header>

    <ion-item>
        <ion-label>
            @if (IsSelecting)
            {
                <p>Selecting photo...</p>
            }
            else
            {
                <p>@(PhotoExists ? "Photo selected" : "No photo selected")</p>
            }
        </ion-label>
    </ion-item>

    <ion-item>
        <div class="ion-margin">
            @if (!IsSelecting)
            {
                <ion-button expand="block" fill="outline" @onclick="StartSelecting">
                    <ion-icon slot="start" name="@(PhotoExists ? "create" : "add-circle")"></ion-icon>
                    @(PhotoExists ? "Change" : "Add") photo
                </ion-button>
            }
        </div>
    </ion-item>

    @if (IsSelecting)
    {
        <ion-item>
            <div class="border border-3">
                @if (PhotoService.IsCameraAvailable)
                {
                    <ion-button color="secondary" @onclick="TakeNativePhoto" disabled="@_busy">
                        <ion-icon slot="start" name="camera"></ion-icon>
                        @(_busy ? "Working..." : "Take Photo")
                    </ion-button>

                    <ion-button color="secondary" @onclick="PickNativePhoto" disabled="@_busy">
                        <ion-icon slot="start" name="images"></ion-icon>
                        @(_busy ? "Working..." : "Choose Photo")
                    </ion-button>
                }
                else
                {
                    <InputFile OnChange="FileSelected" accept="image/*" />
                }
                @if (!string.IsNullOrWhiteSpace(errorText))
                {
                    <div class="alert-danger">@errorText</div>
                }

                @if (!string.IsNullOrEmpty(_stagedPhoto.ImageSource))
                {
                    <img src="@_stagedPhoto.ImageSource" class="img-fluid" style="max-height:40vh" title="@_stagedPhoto.FileName" alt="@AltText" />
                    <br />
                    <ion-button color="secondary" @onclick="UseFile">Use this image</ion-button>
                }
                <ion-button color="secondary" @onclick="CancelChoice"><i class="fas fa-chevron-left" /></ion-button>
            </div>
        </ion-item>
    }
    else if (PhotoExists)
    {
        <ion-item>
            <div class="ion-margin">
                <ion-img src="@Photo!.ImageSource"
                         alt="@AltText"
                         style="max-width: 100%; height: auto; border-radius: 8px;"></ion-img>
            </div>
        </ion-item>
    }
</ion-list>


