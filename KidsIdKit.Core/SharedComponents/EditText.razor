@inherits InputBase<string>
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (IsPassword && !ShowPassword)
{
    <ion-input value="@CurrentValue" fill="outline" mode="md"
               @oninput="OnValueChanged" type="password" style="@Style">
        <ion-input-password-toggle show-icon="@(ShowPassword ? "true" : "")" slot="end"></ion-input-password-toggle>
    </ion-input>
}
else if (Multiline)
{
    <div class="expandable-textarea-wrapper">
        <ion-textarea value="@CurrentValue" fill="outline" mode="md"
                      class="expandable-textarea" rows="@Rows" style="@Style"
                      @oninput="OnValueChanged" @ref="_textareaRef" />
        <span class="textarea-resize-handle" @ref="_handleRef"
              role="separator" aria-orientation="horizontal" aria-label="Resize">
            <ion-icon name="chevron-expand-outline"></ion-icon>
        </span>
    </div>
}
else
{
    <ion-input value="@CurrentValue" fill="outline" mode="md"
               @oninput="OnValueChanged" style="@Style" />
}

@code {
    [Parameter] public bool IsPassword { get; set; } = false;
    [Parameter] public bool ShowPassword { get; set; } = false;
    [Parameter] public bool Multiline { get; set; } = false;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? Label { get; set; }

    private ElementReference _textareaRef;
    private ElementReference _handleRef;
    private IJSObjectReference? _module;
    private bool _wired;

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    private void OnValueChanged(ChangeEventArgs e)
    {
        CurrentValue = e.Value?.ToString() ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Multiline && !_wired)
        {
            _wired = true;
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/KidsIdKit.Core/js/textarea-resize.js");
                await _module.InvokeVoidAsync("attach", _handleRef, _textareaRef);
            }
            catch
            {
                // If JS interop is unavailable (e.g., prerendering), silently skip.
                _wired = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
    }
}
